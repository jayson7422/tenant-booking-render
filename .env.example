# ============================================================
# BayanSpaces / BayanWorkforce environment configuration
# Copy this file to .env for LOCAL DEVELOPMENT ONLY.
# Never commit the real .env file or real secrets.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

# Local Node.js port.
# Render provides PORT automatically in production.
PORT=5177

NODE_ENV=development


# ------------------------------------------------------------
# DATABASE - APPLICATION CONNECTION
# ------------------------------------------------------------

# Local XAMPP / MariaDB configuration.
# Replace these values with the production database credentials
# when configuring the Render environment.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bayan_spaces_dev
DB_USER=bayan_spaces_app
DB_PASSWORD=replace_with_a_unique_local_password

# mysql2 connection-pool size.
DB_CONNECTION_LIMIT=10


# ------------------------------------------------------------
# DATABASE - MIGRATION ADMIN
# ------------------------------------------------------------

# Used only by:
# npm run db:migrate
#
# These credentials are NOT used by the normal application.
# For local XAMPP, root commonly has no password unless changed.

DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=


# ------------------------------------------------------------
# GOOGLE CALENDAR / OAUTH
# ------------------------------------------------------------

# Optional. Leave blank until Google Calendar integration
# is configured.

GOOGLE_CALENDAR_ID=

# Calendar containing manually-created room events. The CRM uses the
# authenticated account's primary calendar by default. Set this to the
# Team Launchpad calendar ID if that calendar is not the account's primary.
GOOGLE_MASTER_CALENDAR_ID=primary

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# LOCAL callback:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5177/api/google/callback

# Secret used to encrypt/decrypt stored OAuth refresh tokens.
# Production must use a strong secret and must retain the same
# value while existing encrypted tokens are being used.
GOOGLE_TOKEN_ENCRYPTION_KEY=


# Optional alternative to OAuth.
# Normally leave these blank when using Google OAuth.

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=


# ------------------------------------------------------------
# EMAIL / SMTP
# ------------------------------------------------------------

# Optional. Required only for sending tenant usage reports.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
