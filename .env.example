# Local MariaDB/MySQL connection. Copy this file to .env and replace secrets.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bayan_spaces_dev
DB_USER=bayan_spaces_app
DB_PASSWORD=replace_with_a_unique_local_password
DB_CONNECTION_LIMIT=10

# Used only by the explicit `npm run db:migrate` administration command.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Existing application configuration remains server-side only.
PORT=5177
BOOKING_PORT=6500
CORE_PORT=5177

# Optional integrations. Never commit real values.
GOOGLE_CALENDAR_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:6500/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
